{
	"schemaVersion": 1,
	"id": "lowballhelper",
	"version": "${version}",
	"name": "Lowball Helper",
	"description": "Hypixel SkyBlock lowballing assistant: live LBIN, sales volume, listings, upgrade, craft and exotic value with a full breakdown and a suggested offer next to the trade menu.",
	"authors": [
		"skylerressi-eng"
	],
	"contact": {
		"sources": "https://github.com/skylerressi-eng/Lowballing-modd"
	},
	"license": "MIT",
	"icon": "assets/lowballhelper/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.lowball.helper.client.LowballHelperClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft_range}",
		"fabric-screen-api-v1": "*",
		"fabric-command-api-v2": "*",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-item-api-v1": "*"
	}
}
